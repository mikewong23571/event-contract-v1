# =============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
.stylelintcache

# Runtime logs
backend/logs/
runtime/logs/
notifications/logs/
backtesting/logs/

