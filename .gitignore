tmp/
temp/
*.tmp
*.temp

# =============================================================================
# OS SPECIFIC
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# PACKAGE MANAGER
# =============================================================================
# npm
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# yarn
yarn.lock

# pnpm
pnpm-lock.yaml

# pip
pip-log.txt
pip-delete-this-directory.txt

# Poetry
poetry.lock

