# Event Contract Trading System - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Main database)
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/event_contract_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_contract_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password

# InfluxDB (Time-series data)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=dev_token_for_development_only
INFLUXDB_ORG=trading
INFLUXDB_BUCKET=market_data

# Redis (Caching and message queuing)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# BINANCE API CONFIGURATION
# =============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true
BINANCE_BASE_URL=https://testnet.binance.vision

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_VERSION=v1

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# JWT/Auth settings (if needed later)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# RUNTIME ENGINE CONFIGURATION
# =============================================================================
RUNTIME_HOST=localhost
RUNTIME_PORT=8001
RUNTIME_WS_PATH=/ws/runtime

# Signal detection settings
SIGNAL_INTERVAL=1.0
MIN_CONFIDENCE=0.6
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT

# =============================================================================
# NOTIFICATIONS CONFIGURATION
# =============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=chat_id_1,chat_id_2
TELEGRAM_ENABLED=false

# Feishu (Lark) Integration
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_WEBHOOK_URL=https://open.feishu.cn/your_webhook
FEISHU_ENABLED=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=alerts@yourdomain.com
EMAIL_RECIPIENTS=trader1@email.com,trader2@email.com
EMAIL_ENABLED=false

# Notification settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=5.0
BATCH_SIZE=100
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CELERY CONFIGURATION (Notifications)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/event-contract.log

# Component-specific log levels
BACKEND_LOG_LEVEL=INFO
RUNTIME_LOG_LEVEL=INFO
NOTIFICATIONS_LOG_LEVEL=INFO
BACKTESTING_LOG_LEVEL=INFO

# =============================================================================
# MONITORING & METRICS
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_GATEWAY=http://localhost:9091

# Health check settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Docker Compose profiles
COMPOSE_PROFILES=default,dev-tools

# Test database (separate from development)
TEST_DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/event_contract_test

# Hot reload settings
BACKEND_RELOAD=true
FRONTEND_FAST_REFRESH=true

# =============================================================================
# PRODUCTION OVERRIDES (uncomment and modify for production)
# =============================================================================

# NODE_ENV=production
# DEBUG=false
# BINANCE_TESTNET=false
# BINANCE_BASE_URL=https://api.binance.com
# CORS_ORIGINS=https://your-production-domain.com
# DATABASE_URL=postgresql://prod_user:secure_password@prod-db:5432/event_contract_prod
# REDIS_URL=redis://prod-redis:6379/0
# INFLUXDB_URL=http://prod-influxdb:8086
# JWT_SECRET_KEY=very_secure_production_secret_key
# LOG_LEVEL=WARNING