[flake8]
# Global flake8 configuration for all Python components
max-line-length = 88
max-complexity = 12
select = E,W,F,C
ignore = 
    # Black compatibility
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator (black handles this)
    # Docstring requirements (can be enabled later)
    D100,  # Missing docstring in public module
    D101,  # Missing docstring in public class
    D102,  # Missing docstring in public method
    D103,  # Missing docstring in public function
    D104,  # Missing docstring in public package
    D105,  # Missing docstring in magic method

exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .venv,
    venv,
    .tox,
    dist,
    build,
    *.egg-info,
    # Component-specific excludes
    backend/migrations,
    backtesting/data,
    backtesting/results,
    runtime/logs,
    notifications/templates

# Import order checking
application-import-names = src,backend,backtesting,runtime,notifications
import-order-style = google

per-file-ignores =
    # Tests can have longer lines and unused imports
    */tests/*:E501,F401,F811
    # Configuration files
    */config/*.py:E501
    # CLI scripts
    */cli/*.py:E501